---
import "../styles/global.css";
---

<head>
  <link rel="icon" href="/assets/logo-vemmed.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#f7f3eb" />
</head>

<a class="skip-link" href="#contato">Pular para o formulário</a>

<main class="contact-page" id="contato">
  <div class="contact-decoration contact-decoration-one" aria-hidden="true"></div>
  <div class="contact-decoration contact-decoration-two" aria-hidden="true"></div>

  <div class="contact-layout">
    <section class="contact-intro" aria-labelledby="contact-title">
      <a class="contact-brand" href="/" aria-label="VemMED, página inicial">
        <img src="/assets/logo-vemmed.svg" alt="VemMED" width="247" height="190" />
      </a>
      <div class="contact-intro-copy">
        <p class="eyebrow"><span>Vamos conversar</span> estamos por aqui</p>
        <h1 id="contact-title">Sua próxima conquista começa com uma boa conversa.</h1>
        <p class="contact-subtitle">
          Conte um pouco sobre você e sua preparação. Nossa equipe vai ler sua mensagem
          com atenção e entrar em contato em breve.
        </p>
      </div>
      <div class="contact-note">
        <span class="contact-note-mark" aria-hidden="true">+</span>
        <p><strong>Preparação com direção.</strong><br />Mais clareza para chegar mais longe.</p>
      </div>
    </section>

    <section class="contact-form-panel" aria-labelledby="form-title">
      <div class="form-heading">
        <p class="eyebrow">Fale com a gente</p>
        <h2 id="form-title">Como podemos ajudar?</h2>
        <p>Preencha os campos abaixo e envie sua mensagem.</p>
      </div>

      <div class="mautic-form" id="mautic-form" aria-label="Formulário de contato"></div>
      <script type="text/javascript" src="https://mautic.vemmed.com.br/form/generate.js?id=1"></script>
    </section>
  </div>
</main>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap");

  .contact-page {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: clamp(28px, 6vw, 72px) 20px;
    background: radial-gradient(circle at 8% 90%, rgba(233, 179, 223, 0.25), transparent 24%), linear-gradient(135deg, var(--paper-light), var(--paper) 52%, #eef8f5);
  }

  .contact-layout {
    position: relative;
    z-index: 1;
    width: min(1100px, 100%);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);
    align-items: center;
    gap: clamp(44px, 8vw, 110px);
  }

  .contact-brand { display: inline-flex; width: 86px; margin-bottom: clamp(42px, 8vw, 90px); }
  .contact-brand img { width: 100%; height: auto; object-fit: contain; }
  .contact-intro-copy { max-width: 510px; }
  .contact-intro .eyebrow, .form-heading .eyebrow { margin-bottom: 18px; color: var(--turquoise-dark); font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .eyebrow span { color: var(--green-dark); }
  .contact-intro h1 { max-width: 520px; margin-bottom: 24px; font-family: var(--font-display); font-size: clamp(2.8rem, 5vw, 5rem); line-height: .98; letter-spacing: -.03em; }
  .contact-subtitle { max-width: 450px; margin-bottom: 0; color: var(--ink-soft); font-size: clamp(1rem, 1.4vw, 1.12rem); line-height: 1.75; }
  .contact-note { display: flex; align-items: center; gap: 14px; margin-top: clamp(40px, 8vw, 80px); color: var(--ink-soft); font-size: .78rem; line-height: 1.5; }
  .contact-note p { margin: 0; }
  .contact-note strong { color: var(--ink); }
  .contact-note-mark { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 50%; background: var(--yellow); color: var(--ink); font-family: var(--font-display); font-size: 1.7rem; transform: rotate(-8deg); }
  .contact-form-panel { padding: clamp(28px, 5vw, 54px); border: 1px solid rgba(16, 24, 43, .1); border-radius: 18px; background: rgba(255, 253, 248, .82); box-shadow: var(--shadow); backdrop-filter: blur(12px); }
  .form-heading h2 { margin-bottom: 10px; font-family: var(--font-display); font-size: clamp(2rem, 3.5vw, 3.1rem); line-height: 1; }
  .form-heading > p:last-child { margin-bottom: 34px; color: var(--ink-soft); font-size: .9rem; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .field-group { display: grid; gap: 8px; margin-bottom: 20px; }
  .field-group label { color: var(--ink); font-size: .76rem; font-weight: 800; }
  .field-group input, .field-group select, .field-group textarea { width: 100%; border: 1px solid var(--line); border-radius: 8px; padding: 14px 15px; background: var(--white); color: var(--ink); font: inherit; font-size: .88rem; transition: border-color 160ms ease, box-shadow 160ms ease; }
  .field-group textarea { min-height: 132px; resize: vertical; }
  .field-group input::placeholder, .field-group textarea::placeholder { color: #8b94a1; }
  .field-group input:focus, .field-group select:focus, .field-group textarea:focus { border-color: var(--turquoise-dark); outline: 0; box-shadow: 0 0 0 3px rgba(40, 200, 194, .18); }
  .form-footer { display: flex; align-items: center; gap: 18px; margin-top: 6px; }
  .form-footer .button { border: 0; }
  .form-footer .button span { margin-left: 10px; font-size: 1.1rem; }
  .form-privacy { margin: 0; color: var(--ink-soft); font-size: .7rem; line-height: 1.4; }
  .form-success { margin: 20px 0 0; padding: 12px 14px; border-left: 3px solid var(--green); background: rgba(22, 148, 71, .08); color: var(--green-dark); font-size: .8rem; font-weight: 700; }
  .contact-decoration { position: absolute; border: 1px solid rgba(40, 200, 194, .3); pointer-events: none; }
  .contact-decoration-one { top: -100px; right: 8%; width: 260px; height: 260px; border-radius: 50%; }
  .contact-decoration-two { bottom: 7%; left: 5%; width: 24px; height: 24px; border-color: var(--pink); transform: rotate(45deg); }

  @media (max-width: 820px) {
    .contact-page { padding-block: 32px 48px; }
    .contact-layout { grid-template-columns: 1fr; gap: 44px; }
    .contact-brand { width: 72px; margin-bottom: 44px; }
    .contact-intro h1 { font-size: clamp(2.8rem, 12vw, 4rem); }
    .contact-note { margin-top: 34px; }
    .contact-form-panel { max-width: 620px; }
  }

  @media (max-width: 520px) {
    .contact-page { padding-inline: 16px; }
    .field-row { grid-template-columns: 1fr; gap: 0; }
    .form-footer { align-items: flex-start; flex-direction: column; gap: 14px; }
    .form-footer .button { width: 100%; }
  }
</style>
